 fs/f2fs/data.c                     |  25 +++++++++
 fs/f2fs/file.c                     |   8 ++++++++
 fs/f2fs/f2fs.h                     |   2 +
 fs/f2fs/gc.c                       | 106 ++++++++++++++++++++++++++++---------
 fs/f2fs/gc.h                       |  31 +++++++++++
