+	unsigned long event_type, void *data)
+{
+	if (ib_init_succeed) {
+		spin_lock(&ib_ev_lock);
+		struct ib_event_data *ib_ev_data = data;
+
+		switch (event_type) {
+		case IB_EVENT_TOUCH_BOOSTER:
+			input_booster(ib_ev_data);
+			break;
+		default:
+			break;
+		}
+		spin_unlock(&ib_ev_lock);
+	}
+
+	return 0;
+}
