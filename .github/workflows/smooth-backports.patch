+
+	trigger->key_id = keyId;
+	trigger->event_type = enable;
+	trigger->dev_type = dev_type;
+	INIT_WORK(&trigger->ib_trigger_work, evdev_ib_boost_trigger);
+
+	if (!queue_work(ev_unbound_wq, &trigger->ib_trigger_work)) {
+		kfree(trigger);
+		return false;
+	}
+
+	return true;
+}
