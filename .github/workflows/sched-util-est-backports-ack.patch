From 295c9819eaa904a5a29eb5cb298bc52e1d1351d7 Mon Sep 17 00:00:00 2001
From: Patrick Bellasi <patrick.bellasi@arm.com>
Date: Mon, 5 Nov 2018 14:53:59 +0000
Subject: [PATCH 1/4] BACKPORT: sched/fair: Mask UTIL_AVG_UNCHANGED usages

_task_util_est() is mainly used to add/remove the task contribution
to/from the rq's estimated utilization at task enqueue/dequeue time.
In both cases the UTIL_AVG_UNCHANGED flag is set to keep consistency
between enqueue and dequeue time while still being transparent to
update_load_avg() calls, which eventually reset the flag.

Move the flag forcing inside _task_util_est() itself so the estimated
utilization implementation detail is hidden from the callers. This also
simplifies the enqueue, dequeue and cpu_util_without() sites.

Backported from: 92a801e5d5b7a893881c1676b15dd246727ccd16
("sched/fair: Mask UTIL_AVG_UNCHANGED usages") by Patrick Bellasi.
Source: upstream Linux (torvalds/linux), v4.20 scheduler series.

The target has the same pre-fix util_est layout as the upstream parent;
only context line numbers differ.

This is patch 1/4 of the util_est correctness backport.

Signed-off-by: Patrick Bellasi <patrick.bellasi@arm.com>
Signed-off-by: Devandroid-bit <180217512+Devandroid-bit@users.noreply.github.com>
---
 kernel/sched/fair.c | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index cbb451c13fd72b274152d2770711e254e08b0255..3aa273f02da15db1f3ad910d8ce3c499efaa5099 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -3728,7 +3728,7 @@ static inline unsigned long _task_util_est(struct task_struct *p)
 {
 	struct util_est ue = READ_ONCE(p->se.avg.util_est);
 
-	return max(ue.ewma, ue.enqueued);
+	return (max(ue.ewma, ue.enqueued) | UTIL_AVG_UNCHANGED);
 }
 
 static inline unsigned long task_util_est(struct task_struct *p)
@@ -3751,7 +3751,7 @@ static inline void util_est_enqueue(struct cfs_rq *cfs_rq,
 
 	/* Update root cfs_rq's estimated utilization */
 	enqueued  = cfs_rq->avg.util_est.enqueued;
-	enqueued += (_task_util_est(p) | UTIL_AVG_UNCHANGED);
+	enqueued += _task_util_est(p);
 	WRITE_ONCE(cfs_rq->avg.util_est.enqueued, enqueued);
 
 	trace_sched_util_est_task(p, &p->se.avg);
@@ -3782,8 +3782,7 @@ util_est_dequeue(struct cfs_rq *cfs_rq, struct task_struct *p, bool task_sleep)
 
 	/* Update root cfs_rq's estimated utilization */
 	ue.enqueued  = cfs_rq->avg.util_est.enqueued;
-	ue.enqueued -= min_t(unsigned int, ue.enqueued,
-			     (_task_util_est(p) | UTIL_AVG_UNCHANGED));
+	ue.enqueued -= min_t(unsigned int, ue.enqueued, _task_util_est(p));
 	WRITE_ONCE(cfs_rq->avg.util_est.enqueued, ue.enqueued);
 
 	trace_sched_util_est_cpu(cpu_of(rq_of(cfs_rq)), cfs_rq);
@@ -6092,7 +6091,7 @@ static unsigned long cpu_util_without(int cpu, struct task_struct *p)
 		 */
 		if (unlikely(task_on_rq_queued(p) || current == p)) {
 			estimated -= min_t(unsigned int, estimated,
-					   (_task_util_est(p) | UTIL_AVG_UNCHANGED));
+					   _task_util_est(p));
 		}
 		util = max(util, estimated);
 	}
-- 
