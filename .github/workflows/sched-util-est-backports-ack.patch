From b9f61481dc7b61676eea9d0943e7a00a3cae9910 Mon Sep 17 00:00:00 2001
From: Xuewen Yan <xuewen.yan@unisoc.com>
Date: Fri, 18 Dec 2020 17:27:52 +0800
Subject: [PATCH 2/4] BACKPORT: sched/fair: Avoid stale CPU util_est value for
 schedutil in task dequeue

CPU (root cfs_rq) estimated utilization is currently updated after
dequeue_task_fair() has already notified schedutil. schedutil can
therefore observe a stale CPU_utilization during task ramp-up or
ramp-down.

Split the combined util_est dequeue update into:

 (A) CPU_util_est subtraction in util_est_dequeue()
 (B) task_util_est EWMA update in util_est_update()

Place (A) before the dequeue loops and before schedtune_dequeue_task(),
and keep (B) at the end where the task PELT value has been updated.

Backported from: 8c1f560c1ea3f19e22ba356f62680d9d449c9ec2
("sched/fair: Avoid stale CPU util_est value for schedutil in task
dequeue") by Xuewen Yan.
Source: upstream Linux (torvalds/linux); this commit is an ancestor of the
b89997aa88f0 task util_est filtering fix.

Adapted for the Exynos9820 4.14 tree:
- the target still has a combined util_est_dequeue(cfs_rq, p, task_sleep);
  split it in place into util_est_dequeue() and util_est_update();
- keep the target trace_sched_util_est_cpu() event and the Samsung
  dequeue_multi_load() hook;
- call the CPU-level update before schedtune_dequeue_task() so schedutil
  does not observe the stale root cfs_rq estimate.

This is patch 2/4 of the util_est correctness backport.

Signed-off-by: Xuewen Yan <xuewen.yan@unisoc.com>
Signed-off-by: Devandroid-bit <180217512+Devandroid-bit@users.noreply.github.com>
---
 kernel/sched/fair.c | 38 ++++++++++++++++++++++++++------------
 1 file changed, 26 insertions(+), 12 deletions(-)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 3aa273f02da15db1f3ad910d8ce3c499efaa5099..108c09fcb26bb806c18af27061cb8f10f917d974 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -3758,6 +3758,22 @@ static inline void util_est_enqueue(struct cfs_rq *cfs_rq,
 	trace_sched_util_est_cpu(cpu_of(rq_of(cfs_rq)), cfs_rq);
 }
 
+static inline void util_est_dequeue(struct cfs_rq *cfs_rq,
+				    struct task_struct *p)
+{
+	unsigned int enqueued;
+
+	if (!sched_feat(UTIL_EST))
+		return;
+
+	/* Update root cfs_rq's estimated utilization */
+	enqueued  = cfs_rq->avg.util_est.enqueued;
+	enqueued -= min_t(unsigned int, enqueued, _task_util_est(p));
+	WRITE_ONCE(cfs_rq->avg.util_est.enqueued, enqueued);
+
+	trace_sched_util_est_cpu(cpu_of(rq_of(cfs_rq)), cfs_rq);
+}
+
 /*
  * Check if a (signed) value is within a specified (unsigned) margin,
  * based on the observation that:
@@ -3771,8 +3787,9 @@ static inline bool within_margin(int value, int margin)
 	return ((unsigned int)(value + margin - 1) < (2 * margin - 1));
 }
 
-static void
-util_est_dequeue(struct cfs_rq *cfs_rq, struct task_struct *p, bool task_sleep)
+static inline void util_est_update(struct cfs_rq *cfs_rq,
+				   struct task_struct *p,
+				   bool task_sleep)
 {
 	long last_ewma_diff;
 	struct util_est ue;
@@ -3780,13 +3797,6 @@ util_est_dequeue(struct cfs_rq *cfs_rq, struct task_struct *p, bool task_sleep)
 	if (!sched_feat(UTIL_EST))
 		return;
 
-	/* Update root cfs_rq's estimated utilization */
-	ue.enqueued  = cfs_rq->avg.util_est.enqueued;
-	ue.enqueued -= min_t(unsigned int, ue.enqueued, _task_util_est(p));
-	WRITE_ONCE(cfs_rq->avg.util_est.enqueued, ue.enqueued);
-
-	trace_sched_util_est_cpu(cpu_of(rq_of(cfs_rq)), cfs_rq);
-
 	/*
 	 * Skip update of task's estimated utilization when the task has not
 	 * yet completed an activation, e.g. being migrated.
@@ -3879,8 +3889,11 @@ static inline void
 util_est_enqueue(struct cfs_rq *cfs_rq, struct task_struct *p) {}
 
 static inline void
-util_est_dequeue(struct cfs_rq *cfs_rq, struct task_struct *p,
-		 bool task_sleep) {}
+util_est_dequeue(struct cfs_rq *cfs_rq, struct task_struct *p) {}
+
+static inline void
+util_est_update(struct cfs_rq *cfs_rq, struct task_struct *p,
+		bool task_sleep) {}
 
 #endif /* CONFIG_SMP */
 
@@ -5434,6 +5447,7 @@ static void dequeue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 	 * Let's update schedtune here to ensure the boost value of the
 	 * current task is not more accounted for in the selection of the OPP.
 	 */
+	util_est_dequeue(&rq->cfs, p);
 	schedtune_dequeue_task(p, cpu_of(rq));
 
 	for_each_sched_entity(se) {
@@ -5483,7 +5497,7 @@ static void dequeue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 		walt_dec_cumulative_runnable_avg(rq, p);
 	}
 
-	util_est_dequeue(&rq->cfs, p, task_sleep);
+	util_est_update(&rq->cfs, p, task_sleep);
 	dequeue_multi_load(&rq->cfs, p, task_sleep);
 	hrtick_update(rq);
 }
-- 
